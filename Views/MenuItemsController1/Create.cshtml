@model Online_Restaurant.Models.Menu_Item

@{
    ViewData["Title"] = "Create Menu Item";
    Layout = "~/Views/Shared/DashboardLayout.cshtml";
}
<div asp-validation-summary="All" class="text-danger mb-3"></div>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Menu Items</h2>
            <p class="text-muted mb-0">Add a new meal to: <strong>@ViewBag.CategoryName</strong></p>
        </div>
    </div>

    <div class="card shadow-sm" id="menuItemForm">
        <div class="card-header bg-white">
            <h5 class="mb-0">Add New Item to @ViewBag.CategoryName</h5>
        </div>

        <div class="card-body">
            <form asp-controller="MenuItemsController1" asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <!-- Hidden CategoryId passed from (+) button -->
                <input type="hidden" name="CategoryId" value="@ViewBag.CategoryId" />

                <div class="row">
                    <!-- Item Name -->
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Item Name</label>
                        <input name="Name" class="form-control" placeholder="Enter item name" required />
                    </div>

                    <!-- Price -->
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Price</label>
                        <input type="number" step="0.01" min="0" name="Price" class="form-control" placeholder="Enter price" required />
                    </div>

                    <!-- Availability Switch -->
                    <div class="col-md-6 mb-3 d-flex align-items-center mt-3">
                        <div class="form-check form-switch fs-5">
                            <input class="form-check-input" type="checkbox" name="Available" value="true" id="availableCheck" checked />
                            <input type="hidden" name="Available" value="false" />
                            <label class="form-check-label fs-6" for="availableCheck">Available for Order</label>
                        </div>
                    </div>

                    <!-- Description (Optional -> Null if left empty) -->
                    <div class="col-12 mb-3">
                        <label class="form-label">Description (Optional)</label>
                        <textarea name="Description" class="form-control" rows="3" placeholder="Enter item description..."></textarea>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Add Menu Item</button>
                    <a asp-controller="MenuItemsController1" asp-action="Create" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>