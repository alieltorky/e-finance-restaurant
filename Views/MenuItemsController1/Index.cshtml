@model IEnumerable<Online_Restaurant.Models.Category>

@{
    ViewData["Title"] = "Menu";
    bool isAdmin = ViewBag.IsAdmin ?? false;

    // Set dynamic layout based on user role
    Layout = isAdmin
        ? "~/Views/Shared/DashboardLayout.cshtml"
        : "~/Views/Shared/themedlayout.cshtml";
}

<div class="container my-5">

    <!-- Display alert messages from TempData if available -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Page Header -->
    <div class="text-center mb-4">
        <h1 class="fw-bold">Menu</h1>
    </div>

    <!-- Sticky Navigation Bar for Category Filters -->
    <div class="bg-white py-3 mb-4 border-bottom shadow-sm sticky-top" style="z-index: 1020; top: 0;">
        <div class="d-flex justify-content-center flex-wrap gap-2">
            @foreach (var category in Model)
            {
                <a href="#cat-@category.CategoryId" class="btn btn-outline-dark rounded-pill px-4 fw-semibold">
                    @category.CategoryName
                </a>
            }
        </div>
    </div>

    <!-- Vertical Category Sections -->
    @foreach (var category in Model)
    {
        <section id="cat-@category.CategoryId" class="menu-section mb-5 pt-3">
            <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-4">
                <h3 class="text-primary fw-bold mb-0">
                    @category.CategoryName
                </h3>

                @if (isAdmin)
                {
                    <!-- Admin Add Meal Button (+) -->
                    <a asp-controller="MenuItemsController1"
                       asp-action="Create"
                       asp-route-categoryId="@category.CategoryId"
                       class="btn btn-success btn-sm rounded-pill px-3 d-inline-flex align-items-center gap-1 shadow-sm"
                       title="Add New Meal">
                        <i class="bi bi-plus-lg"></i> Add Item
                    </a>
                }
            </div>

            <!-- Menu Item Cards under current Category -->
            @if (category.MenuItems != null && category.MenuItems.Any())
            {
                <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
                    @foreach (var item in category.MenuItems)
                    {
                        var imageSource = string.IsNullOrEmpty(item.ImagePath) ? "/images/1.png" : item.ImagePath;

                        <div class="col">
                            <div class="card h-100 shadow-sm border-0 rounded-3 overflow-hidden">
                                <!-- Dish Image -->
                                <img src="@imageSource"
                                     class="card-img-top bg-light p-2"
                                     alt="@item.Name"
                                     style="height: 180px; object-fit: contain;" />

                                <div class="card-body d-flex flex-column p-3">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <h5 class="card-title fw-bold fs-6 mb-0 text-dark">@item.Name</h5>
                                        <span class="badge bg-primary rounded-pill ms-2">$@item.Price</span>
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(item.Description) && item.Description != "N/A")
                                    {
                                        <p class="card-text text-muted small flex-grow-1 mb-3">@item.Description</p>
                                    }
                                    else
                                    {
                                        <div class="flex-grow-1"></div>
                                    }

                                    <!-- Actions Based on Role -->
                                    @if (isAdmin)
                                    {
                                        <div class="d-flex flex-column gap-2 mt-auto">
                                            <a asp-controller="MenuItemsController1"
                                               asp-action="Ingredients"
                                               asp-route-id="@item.MenuItemId"
                                               class="btn btn-sm btn-outline-secondary w-100">
                                                <i class="bi bi-list-ul"></i> Ingredients
                                            </a>
                                            <div class="d-flex gap-2">
                                                <a asp-controller="MenuItemsController1"
                                                   asp-action="Edit"
                                                   asp-route-id="@item.MenuItemId"
                                                   class="btn btn-sm btn-warning w-50">
                                                    Edit
                                                </a>
                                                <form asp-controller="MenuItemsController1"
                                                      asp-action="Delete"
                                                      asp-route-id="@item.MenuItemId"
                                                      method="post"
                                                      class="w-50 m-0"
                                                      onsubmit="return confirm('Are you sure you want to delete this item?');">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-danger w-100">
                                                        Delete
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <!-- Add to Cart Button with data-image included -->
                                        <button type="button"
                                                class="btn btn-primary w-100 add-to-cart mt-auto fw-semibold d-flex justify-content-center align-items-center gap-2"
                                                data-id="@item.MenuItemId"
                                                data-name="@item.Name"
                                                data-price="@item.Price"
                                                data-image="@imageSource">
                                            <i class="bi bi-cart-plus"></i> Add to Cart
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <!-- Empty Category Fallback Message -->
                <p class="text-muted fst-italic ms-2">
                    No items available in this category yet.
                </p>
            }
        </section>
    }
</div>

<script>
    let CART_KEY = "cart_guest";
    let cart = [];

    function updateCartCount() {
        let totalItems = 0;
        cart.forEach(item => {
            totalItems += item.quantity;
        });

        const cartCount = document.getElementById("cart-count");
        if (cartCount) {
            cartCount.textContent = totalItems;
        }
    }

    async function determineCartKey() {
        try {
            const authResponse = await fetch("/Account/IsAuthenticated");
            const authData = await authResponse.json();
            return authData.isAuthenticated ? `cart_${authData.userId}` : "cart_guest";
        } catch (err) {
            console.error("Could not determine cart owner, defaulting to guest cart:", err);
            return "cart_guest";
        }
    }

    document.addEventListener("DOMContentLoaded", async function() {
        CART_KEY = await determineCartKey();
        cart = JSON.parse(localStorage.getItem(CART_KEY)) || [];

        updateCartCount();

        const addButtons = document.querySelectorAll(".add-to-cart");
        addButtons.forEach(button => {
            button.addEventListener("click", function() {
                const id = this.dataset.id;
                const name = this.dataset.name;
                const price = parseFloat(this.dataset.price);
                const image = this.dataset.image || "/images/1.png";

                const existingItem = cart.find(item => item.id === id);
                if (existingItem) {
                    existingItem.quantity++;
                } else {
                    cart.push({
                        id: id,
                        name: name,
                        price: price,
                        image: image,
                        quantity: 1
                    });
                }

                localStorage.setItem(CART_KEY, JSON.stringify(cart));
                updateCartCount();
            });
        });
    });
</script>