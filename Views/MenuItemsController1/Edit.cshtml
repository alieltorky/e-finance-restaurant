@model Online_Restaurant.Models.Menu_Item
@using Online_Restaurant.Models

@{
    ViewData["Title"] = "Edit Menu Item";
    Layout = "~/Views/Shared/DashboardLayout.cshtml";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Edit Menu Item</h2>
            <p class="text-muted mb-0">
                Modify item details for:
                <strong>@ViewBag.CategoryName</strong>
            </p>
        </div>
    </div>

    <div class="card shadow-sm mb-4" id="menuItemForm">

        <div class="card-header bg-white">
            <h5 class="mb-0">Edit @Model.Name</h5>
        </div>

        <div class="card-body">

            <form asp-controller="MenuItemsController1"
                  asp-action="Edit"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="MenuItemId" />
                <input type="hidden" asp-for="CategoryId" />

                <div class="row">

                    <!-- Item Name -->
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Item Name</label>

                        <input asp-for="Name"
                               class="form-control"
                               placeholder="Enter item name"
                               required />

                        <span asp-validation-for="Name"
                              class="text-danger"></span>
                    </div>


                    <!-- Price -->
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Price</label>

                        <input asp-for="Price"
                               type="number"
                               step="0.01"
                               min="0"
                               class="form-control"
                               placeholder="Enter price"
                               required />

                        <span asp-validation-for="Price"
                              class="text-danger"></span>
                    </div>


                    <!-- Availability -->
                    <div class="col-md-6 mb-3 d-flex align-items-center mt-3">

                        <div class="form-check form-switch fs-5">

                            <input class="form-check-input"
                                   type="checkbox"
                                   asp-for="Available"
                                   id="availableCheck" />

                            <label class="form-check-label fs-6"
                                   for="availableCheck">
                                Available for Order
                            </label>

                        </div>

                    </div>


                    <!-- Description -->
                    <div class="col-12 mb-3">

                        <label class="form-label">
                            Description (Optional)
                        </label>

                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Enter item description..."></textarea>

                        <span asp-validation-for="Description"
                              class="text-danger"></span>

                    </div>


                    <!-- Image -->
                    <div class="col-md-6 mb-3">

                        <label class="form-label">
                            Menu Item Image
                        </label>

                        <input type="file"
                               name="imageFile"
                               id="imageFile"
                               class="form-control"
                               accept=".jpg,.jpeg,.png" />

                        <small class="text-muted">
                            JPG, JPEG or PNG. Maximum size: 2 MB.
                        </small>

                        <span id="imageError"
                              class="text-danger d-block"></span>

                        @if (!string.IsNullOrEmpty(Model.ImagePath))
                        {
                            <div class="mt-3">

                                <p class="mb-2">
                                    Current Image:
                                </p>

                                <img src="@Model.ImagePath"
                                     id="currentImage"
                                     alt="@Model.Name"
                                     style="width: 180px;
                                height: 180px;
                                object-fit: cover;
                                border-radius: 8px;" />

                            </div>
                        }

                    </div>


                    <!-- New Image Preview -->
                    <div class="col-md-6 mb-3">

                        <div id="previewContainer"
                             style="display:none;">

                            <p class="mb-2">
                                New Image Preview:
                            </p>

                            <img id="imagePreview"
                                 alt="Image Preview"
                                 style="width: 180px;
                            height: 180px;
                            object-fit: cover;
                            border-radius: 8px;" />

                        </div>

                    </div>

                </div>


                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-warning"
                            id="saveButton">
                        Save Changes
                    </button>

                    <a asp-controller="MenuItemsController1"
                       asp-action="AdminMenu"
                       class="btn btn-secondary">
                        Cancel
                    </a>

                </div>

            </form>

        </div>
    </div>


    <!-- INGREDIENTS -->

    <form id="antiForgeryForm">
        @Html.AntiForgeryToken()
    </form>

    <div id="alertBox"
         class="alert alert-danger d-none"
         role="alert">
    </div>


    <!-- INGREDIENTS (read-only — only the Chef role can change these) -->

    <div class="card shadow-sm mb-4">

        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Ingredients</h5>
            <span class="badge bg-secondary">View only — managed by Chef</span>
        </div>

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="table-dark">

                        <tr>
                            <th>Ingredient</th>
                            <th>Quantity</th>
                        </tr>

                    </thead>

                    <tbody>
                        @if (Model.Menu_Ingredients != null && Model.Menu_Ingredients.Any())
                        {
                            @foreach (var mi in Model.Menu_Ingredients)
                            {
                                <tr>
                                    <td>@mi.Ingredient.IngredientName</td>
                                    <td>@mi.Quantity</td>
                                </tr>
                            }
                        }
                    </tbody>

                </table>

            </div>

            @if (Model.Menu_Ingredients == null || !Model.Menu_Ingredients.Any())
            {
                <div class="text-center text-muted py-3">
                    No ingredients added to this menu item yet.
                </div>
            }

        </div>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        $(function() {

            // Image validation
            $('#imageFile').on('change', function() {

                const file = this.files[0];

                $('#imageError').text('');

                if (!file) {
                    $('#previewContainer').hide();
                    return;
                }

                const allowedTypes = [
                    'image/jpeg',
                    'image/png'
                ];

                const maxSize = 2 * 1024 * 1024;

                // Check file type
                if (!allowedTypes.includes(file.type)) {

                    $('#imageError').text(
                        'Only JPG, JPEG and PNG images are allowed.'
                    );

                    this.value = '';
                    $('#previewContainer').hide();

                    return;
                }

                // Check file size
                if (file.size > maxSize) {

                    $('#imageError').text(
                        'Image size cannot exceed 2 MB.'
                    );

                    this.value = '';
                    $('#previewContainer').hide();

                    return;
                }

                // Show preview
                const reader = new FileReader();

                reader.onload = function(e) {

                    $('#imagePreview')
                        .attr('src', e.target.result);

                    $('#previewContainer').show();
                };

                reader.readAsDataURL(file);

            });

        });

    </script>
}