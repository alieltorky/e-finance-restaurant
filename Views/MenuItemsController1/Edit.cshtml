@model Online_Restaurant.Models.Menu_Item

@{
    ViewData["Title"] = "Edit Menu Item";
    Layout = "~/Views/Shared/DashboardLayout.cshtml";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Edit Menu Item</h2>
            <p class="text-muted mb-0">Modify item details for: <strong>@ViewBag.CategoryName</strong></p>
        </div>
    </div>

    <div class="card shadow-sm" id="menuItemForm">
        <div class="card-header bg-white">
            <h5 class="mb-0">Edit @Model.Name</h5>
        </div>

        <div class="card-body">
            <form asp-controller="MenuItemsController1" asp-action="Edit" method="post">
                @Html.AntiForgeryToken()

                <!-- Hidden Primary Key and CategoryId -->
                <input type="hidden" asp-for="MenuItemId" />
                <input type="hidden" asp-for="CategoryId" />

                <div class="row">
                    <!-- Item Name -->
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Item Name</label>
                        <input asp-for="Name" class="form-control" placeholder="Enter item name" required />
                    </div>

                    <!-- Price -->
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Price</label>
                        <input asp-for="Price" type="number" step="0.01" min="0" class="form-control" placeholder="Enter price" required />
                    </div>

                    <!-- Availability Switch -->
                    <div class="col-md-6 mb-3 d-flex align-items-center mt-3">
                        <div class="form-check form-switch fs-5">
                            <input class="form-check-input" type="checkbox" asp-for="Available" id="availableCheck" />
                            <label class="form-check-label fs-6" for="availableCheck">Available for Order</label>
                        </div>
                    </div>

                    <!-- Description -->
                    <div class="col-12 mb-3">
                        <label class="form-label">Description (Optional)</label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Enter item description..."></textarea>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-warning">Save Changes</button>
                    <a asp-controller="MenuItemsController1" asp-action="AdminMenu" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>