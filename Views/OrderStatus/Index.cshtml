@model IEnumerable<Online_Restaurant.Models.OrderStatus>

@{
    ViewData["Title"] = "Order Status";
    Layout = "~/Views/Shared/DashboardLayout.cshtml";
    var orderStatusToEdit = ViewBag.OrderStatusToEdit as Online_Restaurant.Models.OrderStatus;
    bool isEditing = orderStatusToEdit != null;
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Order Status</h2>
            <p class="text-muted mb-0">Manage the possible statuses an order can have</p>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white">
            <h5 class="mb-0">All Order Statuses</h5>
        </div>
        <div class="card-body">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>ID</th>
                                <th>Status Name</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var status in Model)
                            {
                                <tr>
                                    <td>@status.OrderStatusId</td>
                                    <td>@status.StatusName</td>
                                    <td>
                                        <div class="d-flex gap-2">
                                            <a asp-controller="OrderStatus"
                                               asp-action="Index"
                                               asp-route-editId="@status.OrderStatusId"
                                               class="btn btn-sm btn-warning">
                                                Edit
                                            </a>

                                            <form asp-controller="OrderStatus"
                                                  asp-action="Delete"
                                                  method="post"
                                                  onsubmit="return confirm('Are you sure you want to delete this order status?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@status.OrderStatusId" />
                                                <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <h5 class="text-muted">No order statuses found</h5>
                    <p class="text-muted">Add your first order status using the form below.</p>
                </div>
            }
        </div>
    </div>

    <div class="card shadow-sm" id="orderStatusForm">
        <div class="card-header bg-white">
            @if (isEditing)
            {
                <h5 class="mb-0">Edit Order Status</h5>
            }
            else
            {
                <h5 class="mb-0">Add New Order Status</h5>
            }
        </div>
        <div class="card-body">
            @if (isEditing)
            {
                <form action="/OrderStatus/Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="OrderStatusId" value="@orderStatusToEdit.OrderStatusId" />

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Status Name</label>
                            <input name="StatusName" value="@orderStatusToEdit.StatusName" class="form-control" required />
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-success">Save Changes</button>
                        <a href="/OrderStatus/Index" class="btn btn-secondary">Cancel</a>
                    </div>
                </form>
            }
            else
            {
                <form asp-controller="OrderStatus" asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Status Name</label>
                            <input name="StatusName" class="form-control" placeholder="e.g. Pending, Preparing, Delivered" required />
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary">Add Order Status</button>
                </form>
            }
        </div>
    </div>

</div>