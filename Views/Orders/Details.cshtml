@model Online_Restaurant.Models.Orders

@{
    ViewData["Title"] = "Order Details";
    Layout = "~/Views/Shared/ThemedLayout.cshtml";
}

<div class="container my-5" style="max-width: 720px;">

    <a asp-controller="Orders" asp-action="Index" class="btn btn-sm btn-outline-secondary mb-3">
        &larr; Back to My Orders
    </a>

    <div class="card shadow-sm">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Order #@Model.OrderId</h5>
            <span class="badge bg-info text-dark">@Model.OrderStatus?.StatusName</span>
        </div>

        <div class="card-body">
            <p class="mb-1"><strong>Date:</strong> @Model.Date.ToString("dd MMM yyyy, HH:mm")</p>
            <p class="mb-1"><strong>Payment Method:</strong> @Model.PaymentMethod?.MethodName</p>
            <p class="mb-1"><strong>Delivery Address:</strong> @Model.Address</p>
            <p class="mb-3"><strong>Contact Number:</strong> @Model.MobileNumber</p>

            <hr />

            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Item</th>
                        <th>Quantity</th>
                        <th class="text-end">Line Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var detail in Model.OrderDetails)
                    {
                        <tr>
                            <td>@detail.Menu_Item?.Name</td>
                            <td>@detail.Quantity</td>
                            <td class="text-end">$@detail.TotalPrice.ToString("0.00")</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <th colspan="2" class="text-end">Total</th>
                        <th class="text-end">$@Model.Price.ToString("0.00")</th>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>

</div>  