@model Online_Restaurant.ViewModels.InventoryIndexViewModel

@{
    ViewData["Title"] = "Inventory";
    Layout = "~/Views/Shared/DashboardLayout.cshtml";
}

<div class="container-fluid">

    <!-- ================= PAGE HEADER ================= -->

    <div class="mb-4">

        <h2 class="fw-bold">
            Inventory
        </h2>

        <p class="text-muted mb-0">
            Manage ingredient supplies and inventory records
        </p>

    </div>


    <!-- ================= INVENTORY HISTORY ================= -->

    <div class="card shadow-sm mb-4">

        <div class="card-header bg-white">

            <h5 class="mb-0">
                Inventory History
            </h5>

        </div>


        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="table-dark">

                        <tr>

                            <th>
                                ID
                            </th>

                            <th>
                                Ingredient
                            </th>

                            <th>
                                Quantity
                            </th>

                            <th>
                                Cost
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @if (Model.InventoryRecords != null && Model.InventoryRecords.Any())
                        {
                            foreach (var inventory in Model.InventoryRecords)
                            {
                                <tr>

                                    <!-- ID -->

                                    <td>
                                        @inventory.IngredientId
                                    </td>



                                    <!-- INGREDIENT -->

                                    <td>
                                        @(inventory.Ingredient?.IngredientName ?? "Unknown")
                                    </td>


                                    <!-- QUANTITY -->

                                    <td>
                                        @inventory.Quantity
                                    </td>


                                    <!-- COST -->

                                    <td>
                                        @inventory.Cost
                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="6"
                                    class="text-center text-muted py-4">

                                    No inventory records found.

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>


            <!-- ================= PAGINATION ================= -->

            @if (Model.TotalPages > 1)
            {
                var orderedPages = GetPagesToShow(Model.PageNumber, Model.TotalPages);

                <nav>
                    <ul class="pagination justify-content-center mt-3 mb-0 flex-wrap">

                        <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-pageNumber="1">First</a>
                        </li>

                        <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-pageNumber="@(Model.PageNumber - 1)">Previous</a>
                        </li>

                        @{
                            int? previousPage = null;
                        }
                        @foreach (var p in orderedPages)
                        {
                            if (previousPage.HasValue && p - previousPage.Value > 1)
                            {
                                <li class="page-item disabled">
                                    <span class="page-link">...</span>
                                </li>
                            }

                            <li class="page-item @(p == Model.PageNumber ? "active" : "")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-pageNumber="@p">@p</a>
                            </li>

                            previousPage = p;
                        }

                        <li class="page-item @(Model.PageNumber == Model.TotalPages ? "disabled" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-pageNumber="@(Model.PageNumber + 1)">Next</a>
                        </li>

                        <li class="page-item @(Model.PageNumber == Model.TotalPages ? "disabled" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-pageNumber="@Model.TotalPages">Last</a>
                        </li>

                    </ul>
                </nav>
            }

        </div>

    </div>


    <!-- ================= CREATE INVENTORY RECORD ================= -->

    <div class="card shadow-sm">

        <div class="card-header bg-primary text-white">

            <h5 class="mb-0">
                Add Inventory Supply
            </h5>

        </div>


        <div class="card-body">

            <form asp-controller="Inventory"
                  asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()


                <!-- ================= SUPPLIER ================= -->

                <div class="mb-3">

                    <label class="form-label">
                        Supplier
                    </label>

                    <select name="SupplierId"
                            class="form-select"
                            required>

                        <option value="">
                            Select Supplier
                        </option>


                        @if (ViewBag.Suppliers != null)
                        {
                            foreach (var supplier in ViewBag.Suppliers)
                            {
                                <option value="@supplier.SupplierId">

                                    @supplier.CompanyName

                                </option>
                            }
                        }

                    </select>

                </div>


                <!-- ================= INGREDIENT ================= -->

                <div class="mb-3">

                    <label class="form-label">
                        Ingredient
                    </label>

                    <select name="IngredientId"
                            class="form-select"
                            required>

                        <option value="">
                            Select Ingredient
                        </option>


                        @if (ViewBag.Ingredients != null)
                        {
                            foreach (var ingredient in ViewBag.Ingredients)
                            {
                                <option value="@ingredient.IngredientId">

                                    @ingredient.IngredientName

                                </option>
                            }
                        }

                    </select>

                </div>


                <!-- ================= QUANTITY ================= -->

                <div class="mb-3">

                    <label class="form-label">
                        Quantity
                    </label>

                    <input type="number"
                           name="Quantity"
                           class="form-control"
                           min="0.01"
                           step="0.01"
                           placeholder="Enter quantity"
                           required />

                </div>


                <!-- ================= DATE ================= -->

                <div class="mb-3">

                    <label class="form-label">
                        Delivery Date
                    </label>

                    <input type="date"
                           name="DeliveryDate"
                           class="form-control"
                           value="@DateTime.Now.ToString("yyyy-MM-dd")"
                           required />

                </div>


                <!-- ================= COST ================= -->

                <div class="mb-3">

                    <label class="form-label">
                        Cost
                    </label>

                    <input type="number"
                           name="Cost"
                           class="form-control"
                           min="0"
                           step="0.01"
                           placeholder="Enter cost"
                           required />

                </div>


                <!-- ================= ADD ================= -->

                <button type="submit"
                        class="btn btn-primary">

                    Add Inventory

                </button>

            </form>

        </div>

    </div>

</div>

@functions {
    // First 2 pages + last 2 pages + a small window around the current
    // page, de-duplicated and sorted. Used to render "1 2 ... 13 14 15 ... 26 27"
    // instead of a button for every single page.
    private List<int> GetPagesToShow(int currentPage, int totalPages)
    {
        var pages = new List<int> { 1 };

        if (totalPages >= 2)
        {
            pages.Add(2);
        }

        for (int p = currentPage - 2; p <= currentPage + 2; p++)
        {
            if (p >= 1 && p <= totalPages)
            {
                pages.Add(p);
            }
        }

        if (totalPages >= 2)
        {
            pages.Add(totalPages - 1);
        }

        pages.Add(totalPages);

        return pages.Distinct().OrderBy(p => p).ToList();
    }
}