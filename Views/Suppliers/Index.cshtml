@model IEnumerable<Online_Restaurant.Models.Supplier>

@{
    ViewData["Title"] = "Suppliers";
    Layout = "~/Views/Shared/DashboardLayout.cshtml";
    var supplierToEdit = ViewBag.SupplierToEdit as Online_Restaurant.Models.Supplier;

    bool isEditing = supplierToEdit != null;
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <p class="text-muted mb-0">
                Manage restaurant suppliers
            </p>
        </div>

    </div>


    <div class="card shadow-sm mb-4">

        <div class="card-header bg-white">

            <h5 class="mb-0">
                All Suppliers
            </h5>

        </div>


        <div class="card-body">

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-dark">

                            <tr>

                                <th>
                                    ID
                                </th>

                                <th>
                                    Company Name
                                </th>

                                <th>
                                    Contact Person
                                </th>

                                <th>
                                    Phone
                                </th>

                                <th>
                                    Email
                                </th>

                                <th>
                                    Address
                                </th>

                                <th>
                                    Actions
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var supplier in Model)
                            {
                                <tr>

                                    <td>
                                        @supplier.SupplierId
                                    </td>

                                    <td>
                                        @supplier.CompanyName
                                    </td>

                                    <td>
                                        @supplier.ContactPerson
                                    </td>

                                    <td>
                                        @supplier.Phone
                                    </td>

                                    <td>
                                        @supplier.Email
                                    </td>

                                    <td>
                                        @supplier.Address
                                    </td>

                                    <td>

                                        <div class="d-flex gap-2">

                                            <!-- EDIT -->

                                            <a asp-controller="Suppliers"
                                               asp-action="Index"
                                               asp-route-editId="@supplier.SupplierId"
                                               class="btn btn-sm btn-warning">

                                                Edit

                                            </a>


                                            <!-- DELETE -->

                                            <form asp-controller="Suppliers"
                                                  asp-action="Delete"
                                                  method="post"
                                                  onsubmit="return confirm('Are you sure you want to delete this supplier?');">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@supplier.SupplierId" />

                                                <button type="submit"
                                                        class="btn btn-sm btn-danger">

                                                    Delete

                                                </button>

                                            </form>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <h5 class="text-muted">
                        No suppliers found
                    </h5>

                    <p class="text-muted">
                        Add your first supplier using the button above.
                    </p>

                </div>
            }

        </div>

    </div>


    <!-- ================= ADD / EDIT FORM ================= -->

    <div class="card shadow-sm"
         id="supplierForm">

        <div class="card-header bg-white">

            @if (isEditing)
            {
                <h5 class="mb-0">
                    Edit Supplier
                </h5>
            }
            else
            {
                <h5 class="mb-0">
                    Add New Supplier
                </h5>
            }

        </div>


        <div class="card-body">

            @if (isEditing)
            {
                <!-- ================= EDIT FORM ================= -->

                <form asp-controller="Suppliers"
                      asp-action="Edit"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           asp-for="@supplierToEdit.SupplierId" />


                    <div class="row">

                        <!-- COMPANY NAME -->

                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                Company Name
                            </label>

                            <input name="CompanyName"
                                   value="@supplierToEdit.CompanyName"
                                   class="form-control"
                                   required />

                        </div>


                        <!-- CONTACT PERSON -->

                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                Contact Person
                            </label>

                            <input name="ContactPerson"
                                   value="@supplierToEdit.ContactPerson"
                                   class="form-control"
                                   required />

                        </div>


                        <!-- PHONE -->

                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                Phone
                            </label>

                            <input name="Phone"
                                   value="@supplierToEdit.Phone"
                                   class="form-control" />

                        </div>


                        <!-- EMAIL -->

                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                Email
                            </label>

                            <input type="email"
                                   name="Email"
                                   value="@supplierToEdit.Email"
                                   class="form-control" />

                        </div>


                        <!-- ADDRESS -->

                        <div class="col-12 mb-3">

                            <label class="form-label">
                                Address
                            </label>

                            <textarea name="Address"
                                      class="form-control"
                                      rows="3">@supplierToEdit.Address</textarea>

                        </div>

                    </div>


                    <div class="d-flex gap-2">

                        <button type="submit"
                                class="btn btn-success">

                            Save Changes

                        </button>


                        <a asp-controller="Suppliers"
                           asp-action="Index"
                           class="btn btn-secondary">

                            Cancel

                        </a>

                    </div>

                </form>
            }
            else
            {
                <!-- ================= CREATE FORM ================= -->

                <form asp-controller="Suppliers"
                      asp-action="Create"
                      method="post">

                    @Html.AntiForgeryToken()


                    <div class="row">

                        <!-- COMPANY NAME -->

                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                Company Name
                            </label>

                            <input name="CompanyName"
                                   class="form-control"
                                   placeholder="Enter company name"
                                   required />

                        </div>


                        <!-- CONTACT PERSON -->

                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                Contact Person
                            </label>

                            <input name="ContactPerson"
                                   class="form-control"
                                   placeholder="Enter contact person"
                                   required />

                        </div>


                        <!-- PHONE -->

                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                Phone
                            </label>

                            <input name="Phone"
                                   class="form-control"
                                   placeholder="Enter phone number" />

                        </div>


                        <!-- EMAIL -->

                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                Email
                            </label>

                            <input type="email"
                                   name="Email"
                                   class="form-control"
                                   placeholder="Enter email" />

                        </div>


                        <!-- ADDRESS -->

                        <div class="col-12 mb-3">

                            <label class="form-label">
                                Address
                            </label>

                            <textarea name="Address"
                                      class="form-control"
                                      rows="3"
                                      placeholder="Enter address"></textarea>

                        </div>

                    </div>


                    <button type="submit"
                            class="btn btn-primary">

                        Add Supplier

                    </button>

                </form>
            }

        </div>

    </div>

</div>