@model IEnumerable<Online_Restaurant.Models.Menu_Item>
@{
    ViewData["Title"] = "Home";
    Layout = "~/Views/Shared/ThemedLayout.cshtml";

    // ViewData["Title"] = "Dashboard";
    // Layout = "~/Views/Shared/DashboardLayout.cshtml";

    // Duplicate the list so the CSS animation can loop seamlessly (scrolls through
    // the first copy, then keeps going right into the identical second copy).
    var bestSellerItems = Model?.ToList() ?? new List<Online_Restaurant.Models.Menu_Item>();
    var loopedItems = bestSellerItems.Concat(bestSellerItems).ToList();

    // Slower scroll for more items so the pace feels consistent either way.
    var scrollSeconds = Math.Max(15, bestSellerItems.Count * 4);
}
<style>
    .marquee-wrapper {
        overflow: hidden;
        position: relative;
        width: 100%;
        -webkit-mask-image: linear-gradient(to right, transparent 0, black 8%, black 92%, transparent 100%);
        mask-image: linear-gradient(to right, transparent 0, black 8%, black 92%, transparent 100%);
    }

    .marquee-track {
        display: flex;
        width: max-content;
        animation-name: marquee-scroll;
        animation-timing-function: linear;
        animation-iteration-count: infinite;
    }

    /* Pause on hover so people can actually look at / click an item
    .marquee-wrapper:hover .marquee-track {
        animation-play-state: paused;
    } */

    @@keyframes marquee-scroll {
        from {
            transform: translateX(0);
        }

        to {
            transform: translateX(-50%);
        }
    }

    .best-seller-card {
        flex: 0 0 auto;
        width: 220px;
        margin: 0 10px;
        background: #fff;
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
        position: relative;
    }

    .best-seller-badge {
        position: absolute;
        top: 10px;
        left: 10px;
        z-index: 2;
    }

    .best-seller-img {
        width: 100%;
        height: 160px;
        object-fit: contain;
        display: block;
    }

    @@media (max-width: 576px) {
        .best-seller-card {
            width: 160px;
        }

        .best-seller-img {
            height: 120px;
        }
    }
</style>
<div class="text-center my-5 py-3">
    <h1 class="display-4 fw-bold">Welcome to Our Restaurant</h1>
    <p class="lead">Discover our amazing dishes and order online.</p>

    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <a asp-controller="MenuItemsController1" asp-action="Index" class="btn btn-primary btn-lg mt-3">View Menu</a>
    }
    else
    {
        <div class="d-flex justify-content-center gap-3 mt-3">
            <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-lg">Login</a>
            <a asp-controller="Account" asp-action="Register" class="btn btn-outline-primary btn-lg">Register</a>
        </div>
    }
</div>

@if (bestSellerItems.Any())
{
    <section id="best-sellers" class="best-sellers section pt-2 pb-5">
        <div class="container">
            <div class="text-center mb-4">
                <h2 class="fw-bold">Best Sellers</h2>
                <p class="text-muted">Our customers' favorite picks</p>
            </div>
        </div>

        <div class="marquee-wrapper">
            <div class="marquee-track" style="animation-duration: @(scrollSeconds)s;">
                @foreach (var item in loopedItems)
                {
                    var imageSource = string.IsNullOrEmpty(item.ImagePath) ? "/images/1.png" : item.ImagePath;

                    <div class="best-seller-card">
                        <span class="badge bg-danger best-seller-badge">Best Seller</span>
                        <img src="@imageSource" alt="@item.Name" class="best-seller-img" loading="lazy">
                        <div class="best-seller-info text-center p-3">
                            <h5 class="mb-1">@item.Name</h5>
                            <p class="fw-bold text-primary mb-0">@item.Price.ToString("C")</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}

