</div>

<section id="best-sellers" class="best-sellers section pt-2 pb-5">
    <div class="container">
        <div class="text-center mb-4">
            <h2 class="fw-bold">Best Sellers</h2>
            <p class="text-muted">Our customers' favorite picks</p>
        </div>
    </div>

<div class="marquee-wrapper">
    <div id="best-sellers-track" class="marquee-track"></div>
</div>

</section>

<script>
    let CART_KEY = "cart_guest";
    let cart = [];
    function updateCartCount() {
        let totalItems = 0;

        cart.forEach(item => {
            totalItems += item.quantity;
        });

        const cartCount = document.getElementById("cart-count");

        if (cartCount) {
            cartCount.textContent = totalItems;
        }
    }
    async function determineCartKey() {
        try {
            const authResponse = await fetch("/Account/IsAuthenticated");
            const authData = await authResponse.json();

            return authData.isAuthenticated
                ? `cart_${authData.userId}`
                : "cart_guest";

        } catch (err) {
            console.error(
                "Could not determine cart owner, defaulting to guest cart:",
                err
            );

            return "cart_guest";
        }
    }
    function addToCart(button) {

        const id = button.dataset.id;
        const name = button.dataset.name;
        const price = parseFloat(button.dataset.price);
        const image = button.dataset.image || "/images/1.png";

        const existingItem = cart.find(item => item.id === id);

        if (existingItem) {

            existingItem.quantity++;

        } else {

            cart.push({
                id: id,
                name: name,
                price: price,
                image: image,
                quantity: 1
            });
        }

        localStorage.setItem(
            CART_KEY,
            JSON.stringify(cart)
        );

        updateCartCount();

        button.innerHTML = '<i class="bi bi-check-lg"></i>';

        setTimeout(() => {
            button.innerHTML = '<i class="bi bi-cart-plus"></i>';
        }, 700);
    }

    document.addEventListener("DOMContentLoaded", async function () {
        CART_KEY = await determineCartKey();
        cart = JSON.parse(
            localStorage.getItem(CART_KEY)
        ) || [];
        updateCartCount();
        fetch("/Home/GetBestSellers")
            .then(response => {

                if (!response.ok) {
                    throw new Error("Failed to load best sellers");
                }

                return response.json();
            })
            .then(bestSellers => {

                console.log("Best Sellers:", bestSellers);

                const track =
                    document.getElementById("best-sellers-track");

                if (bestSellers.length === 0) {

                    console.log("No best sellers found.");

                    return;
                }

                const items = [
                    ...bestSellers,
                    ...bestSellers
                ];

                items.forEach(item => {

                    const imageSource =
                        item.imagePath || "/images/1.png";
                    const card =
                        document.createElement("div");

                    card.className = "best-seller-card";

                    card.innerHTML = `
                        <span class="badge bg-danger best-seller-badge">
                            Best Seller
                        </span>

                        <img src="${imageSource}"
                             alt="${item.name}"
                             class="best-seller-img"
                             loading="lazy">

                        <div class="best-seller-info text-center p-3">

                            <h5 class="mb-1">
                                ${item.name}
                            </h5>

                            <p class="fw-bold text-primary mb-0">
                                $${item.price}
                            </p>

                            <button type="button"
                                    class="best-seller-cart add-to-cart"
                                    data-id="${item.menuItemId}"
                                    data-name="${item.name}"
                                    data-price="${item.price}"
                                    data-image="${imageSource}"
                                    title="Add to Cart">

                                <i class="bi bi-cart-plus"></i>

                            </button>

                        </div>
                    `;

                    track.appendChild(card);
                    const cartButton =
                        card.querySelector(".best-seller-cart");

                    cartButton.addEventListener("click", function (event) {
                        event.preventDefault();
                        event.stopPropagation();

                        addToCart(this);
                    });
                });
                const scrollSeconds =
                    Math.max(15, bestSellers.length * 4);

                track.style.animationDuration =
                    `${scrollSeconds}s`;
            })
            .catch(error => {

                console.error(
                    "Error loading best sellers:",
                    error
                );
            });
    });
</script>
