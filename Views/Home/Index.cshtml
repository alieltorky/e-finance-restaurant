@{
    ViewData["Title"] = "Home";
    Layout = "~/Views/Shared/ThemedLayout.cshtml";
}

<style>
    .marquee-wrapper {
        overflow: hidden;
        position: relative;
        width: 100%;
        -webkit-mask-image: linear-gradient(to right, transparent 0, black 8%, black 92%, transparent 100%);
        mask-image: linear-gradient(to right, transparent 0, black 8%, black 92%, transparent 100%);
    }

    .marquee-track {
        display: flex;
        width: max-content;
        animation-name: marquee-scroll;
        animation-timing-function: linear;
        animation-iteration-count: infinite;
    }

    .marquee-wrapper:hover .marquee-track {
        animation-play-state: paused;
    }

    @@keyframes marquee-scroll {
        from {
            transform: translateX(0);
        }

        to {
            transform: translateX(-50%);
        }
    }

    .best-seller-card {
        display: block;
        flex: 0 0 auto;
        width: 220px;
        margin: 0 10px;
        background: #fff;
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
        position: relative;
        text-decoration: none;
        color: inherit;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .best-seller-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 6px 18px rgba(0, 0, 0, 0.15);
            color: inherit;
        }

    .best-seller-badge {
        position: absolute;
        top: 10px;
        left: 10px;
        z-index: 2;
    }

    .best-seller-img {
        width: 100%;
        height: 160px;
        object-fit: contain;
        display: block;
    }

    .best-seller-info {
        min-height: 80px;
    }

    @@media (max-width: 576px) {
        .best-seller-card {
            width: 160px;
        }

        .best-seller-img {
            height: 120px;
        }
    }
</style>

<div class="text-center my-5 py-3">
    <h1 class="display-4 fw-bold">Welcome to Our Restaurant</h1>
    <p class="lead">Discover our amazing dishes and order online.</p>

    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <a asp-controller="MenuItemsController1"
           asp-action="Index"
           class="btn btn-primary btn-lg mt-3">
            View Menu
        </a>
    }
    else
    {
        <div class="d-flex justify-content-center gap-3 mt-3">
            <a asp-controller="Account"
               asp-action="Login"
               class="btn btn-primary btn-lg">
                Login
            </a>

            <a asp-controller="Account"
               asp-action="Register"
               class="btn btn-outline-primary btn-lg">
                Register
            </a>
        </div>
    }
</div>

<section id="best-sellers" class="best-sellers section pt-2 pb-5">
    <div class="container">
        <div class="text-center mb-4">
            <h2 class="fw-bold">Best Sellers</h2>
            <p class="text-muted">Our customers' favorite picks</p>
        </div>
    </div>

    <div class="marquee-wrapper">
        <div id="best-sellers-track" class="marquee-track"></div>
    </div>
</section>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        fetch('/Home/GetBestSellers')
            .then(response => {
                if (!response.ok) {
                    throw new Error("Failed to load best sellers");
                }

                return response.json();
            })
            .then(bestSellers => {
                console.log("Best Sellers:", bestSellers);

                const track = document.getElementById("best-sellers-track");

                if (bestSellers.length === 0) {
                    console.log("No best sellers found.");
                    return;
                }

                const items = [...bestSellers, ...bestSellers];

                items.forEach(item => {
                    const imageSource = item.imagePath || "/images/1.png";
                    const card = document.createElement("a");

                    card.href = `/MenuItemsController1/Index#cat-${item.categoryId}`;
                    card.className = "best-seller-card";

                    card.innerHTML = `
                            <span class="badge bg-danger best-seller-badge">
                                Best Seller
                            </span>

                            <img src="${imageSource}"
                                 alt="${item.name}"
                                 class="best-seller-img"
                                 loading="lazy">

                            <div class="best-seller-info text-center p-3">
                                <h5 class="mb-1">${item.name}</h5>
                                <p class="fw-bold text-primary mb-0">
                                    ${item.price}
                                </p>
                            </div>
                        `;

                    track.appendChild(card);
                });

                const scrollSeconds = Math.max(15, bestSellers.length * 4);
                track.style.animationDuration = `${scrollSeconds}s`;
            })
            .catch(error => {
                console.error("Error loading best sellers:", error);
            });
    });
</script>