@model Online_Restaurant.ViewModels.AdminOrdersViewModel
@using Online_Restaurant.Models

@{
    ViewData["Title"] = "All Orders";
    Layout = "~/Views/Shared/DashboardLayout.cshtml";
    var acceptStatus = Model.AllStatuses.FirstOrDefault(s => s.StatusName == "Preparing");
    var rejectStatus = Model.AllStatuses.FirstOrDefault(s => s.StatusName == "Rejected");
}

<div class="container-fluid">

    @Html.AntiForgeryToken()

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">All Orders</h2>
            <p class="text-muted mb-0">Accept or reject an order directly from this page</p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    <div id="statusErrorAlert" class="alert alert-danger" style="display:none;"></div>

    <!-- ================= SEARCH FILTERS ================= -->

    <form asp-controller="AdminOrders" asp-action="Index" method="get" class="row g-2 mb-3 align-items-end">

        <div class="col-md-3">
            <label class="form-label">Order #</label>
            <input type="number" name="orderId" value="@Model.OrderId" class="form-control" placeholder="e.g. 42" />
        </div>

        <div class="col-md-3">
            <label class="form-label">Phone Number</label>
            <input type="text" name="phoneNumber" value="@Model.PhoneNumber" class="form-control" placeholder="e.g. 0101234..." />
        </div>

        <div class="col-md-3">
            <label class="form-label">Delivery Guy</label>
            <select name="deliveryManId" class="form-select">
                <option value="">All</option>
                @foreach (var staff in Model.DeliveryStaff)
                {
                    if (staff.Id == Model.DeliveryManId)
                    {
                        <option value="@staff.Id" selected>@staff.Name</option>
                    }
                    else
                    {
                        <option value="@staff.Id">@staff.Name</option>
                    }
                }
            </select>
        </div>

        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-fill">Search</button>
            <a asp-controller="AdminOrders" asp-action="Index" class="btn btn-outline-secondary flex-fill">Clear</a>
        </div>

    </form>

    <div class="card shadow-sm">
        <div class="card-header bg-white">
            <h5 class="mb-0">Orders</h5>
        </div>

        <div class="card-body">
            @if (Model.Orders != null && Model.Orders.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>Order #</th>
                                <th>Customer</th>
                                <th>Phone Number</th>
                                <th>Date</th>
                                <th>Total</th>
                                <th>Payment Method</th>
                                <th>Delivery Guy</th>
                                <th>Action</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model.Orders)
                            {
                                string statusName = order.OrderStatus?.StatusName;
                                bool isPending = statusName == "Pending";
                                bool isRejected = statusName == "Rejected";
                                // Anything already decided that isn't "Rejected" is treated as the accepted path
                                bool isAcceptedPath = !isPending && !isRejected;

                                <tr>
                                    <td>#@order.OrderId</td>
                                    <td>@order.User?.UserName</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(order.MobileNumber))
                                        {
                                            <span><i class="bi bi-telephone me-1 text-secondary"></i>@order.MobileNumber</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted"><em>N/A</em></span>
                                        }
                                    </td>
                                    <td>@order.Date.ToString("dd MMM yyyy, HH:mm")</td>
                                    <td>$@order.Price.ToString("0.00")</td>
                                    <td>@order.PaymentMethod?.MethodName</td>
                                    <td>@(order.DeliveryMan?.UserName ?? "-")</td>
                                    <td>
                                        <div class="status-cell"
                                             data-order-id="@order.OrderId"
                                             data-accept-status-id="@acceptStatus?.OrderStatusId"
                                             data-reject-status-id="@rejectStatus?.OrderStatusId">

                                            <div class="d-flex gap-3 align-items-center status-radio-group">
                                                <div class="form-check form-check-inline m-0">
                                                    <input class="form-check-input status-radio"
                                                           type="radio"
                                                           name="statusChoice-@order.OrderId"
                                                           id="accept-@order.OrderId"
                                                           value="accept"
                                                           checked="@(isAcceptedPath ? "checked" : null)"
                                                           disabled="@(!isPending ? "disabled" : null)">
                                                    <label class="form-check-label text-success fw-semibold" for="accept-@order.OrderId">Accept</label>
                                                </div>
                                                <div class="form-check form-check-inline m-0">
                                                    <input class="form-check-input status-radio"
                                                           type="radio"
                                                           name="statusChoice-@order.OrderId"
                                                           id="reject-@order.OrderId"
                                                           value="reject"
                                                           checked="@(isRejected ? "checked" : null)"
                                                           disabled="@(!isPending ? "disabled" : null)">
                                                    <label class="form-check-label text-danger fw-semibold" for="reject-@order.OrderId">Reject</label>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="status-label fw-bold" data-order-id-status="@order.OrderId">
                                            @statusName
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- ================= PAGINATION ================= -->
                @if (Model.TotalPages > 1)
                {
                    var orderedPages = GetPagesToShow(Model.PageNumber, Model.TotalPages);

                    <nav>
                        <ul class="pagination justify-content-center mt-3 flex-wrap">

                            <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-orderId="@Model.OrderId"
                                   asp-route-phoneNumber="@Model.PhoneNumber"
                                   asp-route-deliveryManId="@Model.DeliveryManId"
                                   asp-route-pageNumber="1">First</a>
                            </li>

                            <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-orderId="@Model.OrderId"
                                   asp-route-phoneNumber="@Model.PhoneNumber"
                                   asp-route-deliveryManId="@Model.DeliveryManId"
                                   asp-route-pageNumber="@(Model.PageNumber - 1)">Previous</a>
                            </li>

                            @{
                                int? previousPage = null;
                            }
                            @foreach (var p in orderedPages)
                            {
                                if (previousPage.HasValue && p - previousPage.Value > 1)
                                {
                                    <li class="page-item disabled">
                                        <span class="page-link">...</span>
                                    </li>
                                }

                                <li class="page-item @(p == Model.PageNumber ? "active" : "")">
                                    <a class="page-link"
                                       asp-action="Index"
                                       asp-route-orderId="@Model.OrderId"
                                       asp-route-phoneNumber="@Model.PhoneNumber"
                                       asp-route-deliveryManId="@Model.DeliveryManId"
                                       asp-route-pageNumber="@p">@p</a>
                                </li>

                                previousPage = p;
                            }

                            <li class="page-item @(Model.PageNumber == Model.TotalPages ? "disabled" : "")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-orderId="@Model.OrderId"
                                   asp-route-phoneNumber="@Model.PhoneNumber"
                                   asp-route-deliveryManId="@Model.DeliveryManId"
                                   asp-route-pageNumber="@(Model.PageNumber + 1)">Next</a>
                            </li>

                            <li class="page-item @(Model.PageNumber == Model.TotalPages ? "disabled" : "")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-orderId="@Model.OrderId"
                                   asp-route-phoneNumber="@Model.PhoneNumber"
                                   asp-route-deliveryManId="@Model.DeliveryManId"
                                   asp-route-pageNumber="@Model.TotalPages">Last</a>
                            </li>

                        </ul>
                    </nav>
                }
            }
            else
            {
                <div class="text-center py-5">
                    <h5 class="text-muted">No orders match your search</h5>
                </div>
            }
        </div>
    </div>

</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            const errorAlert = document.getElementById("statusErrorAlert");

            document.addEventListener("change", async function(e) {
                if (!e.target.classList.contains("status-radio")) return;

                const radio = e.target;
                const cell = radio.closest(".status-cell");
                const allRadios = cell.querySelectorAll(".status-radio");
                const orderId = cell.dataset.orderId;
                const statusLabel = document.querySelector(`.status-label[data-order-id-status="${orderId}"]`);

                const choice = radio.value; // "accept" or "reject"
                const orderStatusId = choice === "accept"
                    ? cell.dataset.acceptStatusId
                    : cell.dataset.rejectStatusId;

                const confirmed = confirm(
                    `Are you sure you want to ${choice.toUpperCase()} order #${orderId}?`
                );

                if (!confirmed) {
                    radio.checked = false;
                    return;
                }

                allRadios.forEach(r => r.disabled = true);
                if (errorAlert) errorAlert.style.display = "none";

                try {
                    const response = await fetch('@Url.Action("UpdateStatus", "AdminOrders")', {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json",
                            "RequestVerificationToken": token
                        },
                        body: JSON.stringify({
                            orderId: Number(orderId),
                            orderStatusId: Number(orderStatusId)
                        })
                    });

                    const data = await response.json();

                    if (response.ok && data.success) {
                        // Radios stay visible, both remain disabled, chosen one stays checked
                        statusLabel.textContent = data.statusName;
                    } else {
                        showError(data.message || "Failed to update status.");
                        radio.checked = false;
                        allRadios.forEach(r => r.disabled = false);
                    }
                } catch (err) {
                    showError("Something went wrong updating the status.");
                    radio.checked = false;
                    allRadios.forEach(r => r.disabled = false);
                }
            });
            function showError(message) {
                if (!errorAlert) return;
                errorAlert.textContent = message;
                errorAlert.style.display = "block";
            }
        });
    </script>
}

@functions {

    private List<int> GetPagesToShow(int currentPage, int totalPages)
    {
        var pages = new List<int> { 1 };

        if (totalPages >= 2)
        {
            pages.Add(2);
        }

        for (int p = currentPage - 2; p <= currentPage + 2; p++)
        {
            if (p >= 1 && p <= totalPages)
            {
                pages.Add(p);
            }
        }

        if (totalPages >= 2)
        {
            pages.Add(totalPages - 1);
        }

        pages.Add(totalPages);

        return pages.Distinct().OrderBy(p => p).ToList();
    }
}