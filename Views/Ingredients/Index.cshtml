@model IEnumerable<Online_Restaurant.Models.Ingredient>

@{
    ViewData["Title"] = "Ingredients";
    Layout = "~/Views/Shared/DashboardLayout.cshtml";

    var ingredientToEdit =
        ViewBag.IngredientToEdit as Online_Restaurant.Models.Ingredient;

    bool isEditing = ingredientToEdit != null;
}

<div class="container-fluid">

    <!-- ================= PAGE HEADER ================= -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="mb-1">
                Ingredients
            </h2>

            <p class="text-muted mb-0">
                Manage restaurant ingredients
            </p>

        </div>

    </div>


    <!-- ================= INGREDIENTS TABLE ================= -->

    <div class="card shadow-sm mb-4">

        <div class="card-header bg-white">

            <h5 class="mb-0">
                All Ingredients
            </h5>

        </div>


        <div class="card-body">

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-dark">

                            <tr>

                                <th>
                                    ID
                                </th>

                                <th>
                                    Ingredient Name
                                </th>

                                <th>
                                    Actions
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var ingredient in Model)
                            {
                                <tr>

                                    <td>
                                        @ingredient.IngredientId
                                    </td>

                                    <td>
                                        @ingredient.IngredientName
                                    </td>

                                    <td>

                                        <div class="d-flex gap-2 align-items-center">

                                            <!-- EDIT -->

                                            <a asp-controller="Ingredients"
                                               asp-action="Index"
                                               asp-route-editId="@ingredient.IngredientId"
                                               class="btn btn-sm btn-warning py-1 px-2">

                                                Edit

                                            </a>


                                            <!-- DELETE -->

                                            <form asp-controller="Ingredients"
                                                  asp-action="Delete"
                                                  method="post"
                                                  onsubmit="return confirm('Are you sure you want to delete this ingredient?');"
                                                  class="m-0">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@ingredient.IngredientId" />

                                                <button type="submit"
                                                        class="btn btn-sm btn-danger py-1 px-2">

                                                    Delete

                                                </button>

                                            </form>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <h5 class="text-muted">
                        No ingredients found
                    </h5>

                    <p class="text-muted">
                        Add your first ingredient using the form below.
                    </p>

                </div>
            }

        </div>

    </div>


    <!-- ================= ADD / EDIT FORM ================= -->

    <div class="card shadow-sm"
         id="ingredientForm">

        <div class="card-header bg-white">

            @if (isEditing)
            {
                <h5 class="mb-0">
                    Edit Ingredient
                </h5>
            }
            else
            {
                <h5 class="mb-0">
                    Add New Ingredient
                </h5>
            }

        </div>


        <div class="card-body">

            @if (isEditing)
            {
                <!-- ================= EDIT FORM ================= -->

                <form asp-controller="Ingredients"
                      asp-action="Edit"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="IngredientId"
                           value="@ingredientToEdit.IngredientId" />


                    <div class="mb-3">

                        <label class="form-label">
                            Ingredient Name
                        </label>

                        <input name="IngredientName"
                               value="@ingredientToEdit.IngredientName"
                               class="form-control"
                               required />

                    </div>


                    <div class="d-flex gap-2">

                        <button type="submit"
                                class="btn btn-success">

                            Save Changes

                        </button>


                        <a asp-controller="Ingredients"
                           asp-action="Index"
                           class="btn btn-secondary">

                            Cancel

                        </a>

                    </div>

                </form>
            }
            else
            {
                <!-- ================= CREATE FORM ================= -->

                <form asp-controller="Ingredients"
                      asp-action="Create"
                      method="post">

                    @Html.AntiForgeryToken()


                    <div class="mb-3">

                        <label class="form-label">
                            Ingredient Name
                        </label>

                        <input name="IngredientName"
                               class="form-control"
                               placeholder="Enter ingredient name"
                               required />

                    </div>


                    <button type="submit"
                            class="btn btn-primary">

                        Add Ingredient

                    </button>

                </form>
            }

        </div>

    </div>

</div>