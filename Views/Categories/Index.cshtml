@model IEnumerable<Online_Restaurant.Models.Category>

@{
    ViewData["Title"] = "Categories";
    Layout = "~/Views/Shared/DashboardLayout.cshtml";
    var categoryToEdit = ViewBag.CategoryToEdit as Online_Restaurant.Models.Category;

    bool isEditing = categoryToEdit != null;
}

<div class="container-fluid">

    <!-- ================= PAGE HEADER ================= -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="mb-1">Categories</h2>

            <p class="text-muted mb-0">
                Manage menu categories
            </p>
        </div>

    </div>


    <!-- ================= CATEGORIES TABLE ================= -->

    <div class="card shadow-sm mb-4">

        <div class="card-header bg-white">

            <h5 class="mb-0">
                All Categories
            </h5>

        </div>


        <div class="card-body">

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-dark">

                            <tr>

                                <th>
                                    ID
                                </th>

                                <th>
                                    Category Name
                                </th>

                                <th>
                                    Actions
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var category in Model)
                            {
                                <tr>

                                    <td>
                                        @category.CategoryId
                                    </td>

                                    <td>
                                        @category.CategoryName
                                    </td>

                                    <td>

                                        <div class="d-flex gap-2">

                                            <!-- EDIT -->

                                            <a asp-controller="Categories"
                                               asp-action="Index"
                                               asp-route-editId="@category.CategoryId"
                                               class="btn btn-sm btn-warning py-1 px-2">
                                                Edit
                                            </a>


                                            <!-- DELETE -->

                                            <form asp-controller="Categories"
                                                  asp-action="Delete"
                                                  method="post"
                                                  onsubmit="return confirm('Are you sure you want to delete this category?');">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@category.CategoryId" />

                                                <button type="submit"
                                                        class="btn btn-sm btn-danger">

                                                    Delete

                                                </button>

                                            </form>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <h5 class="text-muted">
                        No categories found
                    </h5>

                    <p class="text-muted">
                        Add your first category using the form below.
                    </p>

                </div>
            }

        </div>

    </div>


    <!-- ================= ADD / EDIT FORM ================= -->

    <div class="card shadow-sm"
         id="categoryForm">

        <div class="card-header bg-white">

            @if (isEditing)
            {
                <h5 class="mb-0">
                    Edit Category
                </h5>
            }
            else
            {
                <h5 class="mb-0">
                    Add New Category
                </h5>
            }

        </div>


        <div class="card-body">

            @if (isEditing)
            {
                <form asp-controller="Categories"
                      asp-action="Edit"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="CategoryId"
                           value="@categoryToEdit.CategoryId" />

                    <div class="row">

                        <div class="col-md-12 mb-3">
                            <label class="form-label">
                                Category Name
                            </label>

                            <input name="CategoryName"
                                   value="@categoryToEdit.CategoryName"
                                   class="form-control"
                                   required />
                        </div>

                    </div>

                    <div class="d-flex gap-2">

                        <button type="submit"
                                class="btn btn-success">
                            Save Changes
                        </button>

                        <a asp-controller="Categories"
                           asp-action="Index"
                           class="btn btn-secondary">
                            Cancel
                        </a>

                    </div>

                </form>
            }
            else
            {
                <!-- ================= CREATE FORM ================= -->

                <form asp-controller="Categories"
                      asp-action="Create"
                      method="post">

                    @Html.AntiForgeryToken()


                    <div class="row">

                        <!-- CATEGORY NAME -->

                        <div class="col-md-12 mb-3">

                            <label class="form-label">
                                Category Name
                            </label>

                            <input name="CategoryName"
                                   class="form-control"
                                   placeholder="Enter category name"
                                   required />

                        </div>

                    </div>


                    <button type="submit"
                            class="btn btn-primary">

                        Add Category

                    </button>

                </form>
            }

        </div>

    </div>

</div>