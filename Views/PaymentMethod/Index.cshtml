@model IEnumerable<Online_Restaurant.Models.PaymentMethod>

@{
    ViewData["Title"] = "Payment Methods";
    Layout = "~/Views/Shared/DashboardLayout.cshtml";
    var paymentMethodToEdit = ViewBag.PaymentMethodToEdit as Online_Restaurant.Models.PaymentMethod;
    bool isEditing = paymentMethodToEdit != null;
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Payment Methods</h2>
            <p class="text-muted mb-0">Manage the payment methods available for orders</p>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white">
            <h5 class="mb-0">All Payment Methods</h5>
        </div>
        <div class="card-body">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>ID</th>
                                <th>Method Name</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var paymentMethod in Model)
                            {
                                <tr>
                                    <td>@paymentMethod.PaymentMethodId</td>
                                    <td>@paymentMethod.MethodName</td>
                                    <td>
                                        <div class="d-flex gap-2">
                                            <a asp-controller="PaymentMethod"
                                               asp-action="Index"
                                               asp-route-editId="@paymentMethod.PaymentMethodId"
                                               class="btn btn-sm btn-warning">
                                                Edit
                                            </a>

                                            <form asp-controller="PaymentMethod"
                                                  asp-action="Delete"
                                                  method="post"
                                                  onsubmit="return confirm('Are you sure you want to delete this payment method?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@paymentMethod.PaymentMethodId" />
                                                <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <h5 class="text-muted">No payment methods found</h5>
                    <p class="text-muted">Add your first payment method using the form below.</p>
                </div>
            }
        </div>
    </div>

    <div class="card shadow-sm" id="paymentMethodForm">
        <div class="card-header bg-white">
            @if (isEditing)
            {
                <h5 class="mb-0">Edit Payment Method</h5>
            }
            else
            {
                <h5 class="mb-0">Add New Payment Method</h5>
            }
        </div>
        <div class="card-body">
            @if (isEditing)
            {
                <form action="/PaymentMethod/Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="PaymentMethodId" value="@paymentMethodToEdit.PaymentMethodId" />

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Method Name</label>
                            <input name="MethodName" value="@paymentMethodToEdit.MethodName" class="form-control" required />
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-success">Save Changes</button>
                        <a href="/PaymentMethod/Index" class="btn btn-secondary">Cancel</a>
                    </div>
                </form>
            }
            else
            {
                <form asp-controller="PaymentMethod" asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Method Name</label>
                            <input name="MethodName" class="form-control" placeholder="e.g. Cash, Credit Card, Wallet" required />
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary">Add Payment Method</button>
                </form>
            }
        </div>
    </div>

</div>